// Cloudflare Worker für die Fortschrittsanzeige (Namen + Fortschritt der Übungen).
// Wird beim Verbinden mit GitHub automatisch bei jedem Push veröffentlicht.
// Der Name muss mit dem Namen des Workers im Cloudflare-Dashboard übereinstimmen.
{
  "name": "kb2-notfall-fortschritt",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "RAUM", "class_name": "Raum" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Raum"] }
  ]
}
